{
  "name": "@myboard/sdk",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "packages/sdk",
  "sourceRoot": "packages/sdk/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --project tsconfig.json",
        "cwd": "packages/sdk"
      },
      "outputs": ["{projectRoot}/dist"]
    }
  }
}
