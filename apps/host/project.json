{
  "name": "host",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "apps/host",
  "sourceRoot": "apps/host/src",
  "projectType": "application",
  "tags": [],
  "implicitDependencies": [
    "@myboard/mb-notes",
    "@myboard/mb-pomodoro"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec vite build --config packages/mb-notes/vite.config.ts",
          "pnpm exec vite build --config packages/mb-pomodoro/vite.config.ts",
          "pnpm exec next build apps/host"
        ]
      }
    }
  }
}
